# bigwash-hq — copy to .env (do not commit .env)

PORT=3000
BIGWASH_AS_ROOT=/path/to/bigwash-hq

AFLDB_URL=http://127.0.0.1:40610
AFLDB_ADMIN_KEY=change-me
AFLDB_WRITE_KEY=change-me
AFLDB_READ_KEY=change-me

JWT_SECRET=change-me-long-random
JWT_TTL_SEC=86400
# Initial admin password for provision seed only — change after first login
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_PHONE=
HQ_COMPANY_ID=company-hq-001
