# bigwash-as/.env.example
# 2026-04-09

# Server
PORT=3000
NODE_ENV=development
DEBUG=false

# Database
DATABASE_URL=postgresql://localhost/bigwash_as
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bigwash_as

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PASSWORD_SALT=bigwash-salt

# SMS/Notification
SMS_GATEWAY_URL=https://api.sms-provider.kr/send
SMS_API_KEY=your-sms-api-key
BUSINESS_PHONE=010-0000-0000
ADMIN_PHONE=031-1688-7759

# Admin Account
ADMIN_PASSWORD=admin123

# Kakao
KAKAO_CHANNEL_ID=@bigwash
KAKAO_API_KEY=your-kakao-api-key
