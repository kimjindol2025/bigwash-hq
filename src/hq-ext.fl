      (let [$cid (?? (server-req-query $req "customer_id") "")
            $eid (?? (server-req-query $req "equipment_id") "")
            $as (?? (server-req-query $req "as_of") (iso-now))]
        (json-ok (warranty-hint (cid $gate) $cid $eid $as))))))

(defn handle-customer-extra-get [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$id (server-req-param $req "id")
            $ex (db-row (db-get-row "hq_customer_extra" $id))]
        (json-ok (if (nil? $ex)
                    {"customer_id" $id "region_id" "" "grade" "" "settle_memo" "" "warranty_memo" ""}
                    $ex))))))

(defn handle-customer-extra-set [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$id (server-req-param $req "id")
            $body (req-body $req)
            $ex (db-row (db-get-row "hq_customer_extra" $id))
            $row {"customer_id" $id
                  "company_id" (cid $gate)
                  "region_id" (?? (get $body "region_id") "")
                  "grade" (?? (get $body "grade") "")
                  "settle_memo" (?? (get $body "settle_memo") "")
                  "warranty_memo" (?? (get $body "warranty_memo") "")
                  "updated_at" (iso-now)}]
        (if (nil? $ex) (db-insert "hq_customer_extra" $row)
            (db-patch "hq_customer_extra" $id $row))
        (json-ok $row)))))

(defn handle-customer-update [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$id (server-req-param $req "id")
            $body (req-body $req)
            $c (db-row (db-get-row "hq_customers" $id))]
        (if (or (nil? $c) (not (= (get $c "company_id") (cid $gate))))
          (json-err 404 "Not found")
          (let [$now (iso-now)
                $patch {"display_name" (?? (get $body "display_name") (get $c "display_name"))
                        "type" (?? (get $body "type") (get $c "type"))
                        "legal_name" (?? (get $body "legal_name") (get $c "legal_name"))
                        "extra_phone" (?? (get $body "extra_phone") (get $c "extra_phone"))
                        "contact_name" (?? (get $body "contact_name") (get $c "contact_name"))
                        "contact_phone" (?? (get $body "contact_phone") (get $c "contact_phone"))
                        "address" (?? (get $body "address") (get $c "address"))
                        "visit_note" (?? (get $body "visit_note") (get $c "visit_note"))
                        "status" (?? (get $body "status") (get $c "status"))
                        "account_owner_user_id" (?? (get $body "account_owner_user_id") (get $c "account_owner_user_id"))
                        "tags" (?? (get $body "tags") (get $c "tags"))
                        "hours_note" (?? (get $body "hours_note") (get $c "hours_note"))
                        "updated_at" $now}]
            (do
              (db-patch "hq_customers" $id $patch)
              (if (or (get $body "region_id") (get $body "grade") (get $body "settle_memo") (get $body "warranty_memo"))
                (let [$ex (db-row (db-get-row "hq_customer_extra" $id))
                      $erow {"customer_id" $id
                             "company_id" (cid $gate)
                             "region_id" (?? (get $body "region_id") (if (nil? $ex) "" (get $ex "region_id")))
                             "grade" (?? (get $body "grade") (if (nil? $ex) "" (get $ex "grade")))
                             "settle_memo" (?? (get $body "settle_memo") (if (nil? $ex) "" (get $ex "settle_memo")))
                             "warranty_memo" (?? (get $body "warranty_memo") (if (nil? $ex) "" (get $ex "warranty_memo")))
                             "updated_at" $now}]
                  (if (nil? $ex) (db-insert "hq_customer_extra" $erow) (db-patch "hq_customer_extra" $id $erow))))
              (json-ok (db-row (db-get-row "hq_customers" $id))))))))))

(defn handle-assignees-list [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (json-ok (db-rows (db-query "hq_ticket_assignees" {"ticket_id" (server-req-param $req "id")}))))))

(defn handle-assignees-set [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$tid (server-req-param $req "id")
            $body (req-body $req)
            $items (?? (get $body "assignees") [])]
        ;; replace set: delete-not-available → insert new rows (keep old rows, mark by rewriting all with new ids only)
        (reduce (fn [$acc $it]
                  (let [$kind (?? (get $it "kind") "staff")
                        $uid (?? (get $it "user_id") "")
                        $cname (?? (get $it "contractor_name") "")
                        $primary (?? (get $it "is_primary") "false")
                        $pay (?? (get $it "day_pay_amount") 0)]
                    (if (and (= $kind "staff") (not (= $uid "")))
                      (let [$u (db-row (db-get-row "hq_users" $uid))]
                        (if (or (nil? $u) (not (= (get $u "employment_status") "active")))
                          $acc
                          (do
                            (db-insert "hq_ticket_assignees"
                                       {"row_id" (new-id "asg")
                                        "company_id" (cid $gate)
                                        "ticket_id" $tid
                                        "user_id" $uid
                                        "contractor_name" ""
                                        "kind" "staff"
                                        "is_primary" $primary
                                        "day_pay_amount" 0
                                        "created_at" (iso-now)})
                            (append $acc [1]))))
                      (do
                        (db-insert "hq_ticket_assignees"
                                   {"row_id" (new-id "asg")
                                    "company_id" (cid $gate)
                                    "ticket_id" $tid
                                    "user_id" ""
                                    "contractor_name" $cname
                                    "kind" "contractor"
                                    "is_primary" $primary
                                    "day_pay_amount" $pay
                                    "created_at" (iso-now)})
                        (append $acc [1])))))
                []
                $items)
        ;; sync primary to ticket.assignee_id
        (let [$primary (filter (fn [$x] (= (?? (get $x "is_primary") "") "true")) $items)
              $p0 (if (> (length $primary) 0) (get $primary 0) nil)]
          (if (and (not (nil? $p0)) (= (?? (get $p0 "kind") "") "staff"))
            (db-patch "hq_tickets" $tid {"assignee_id" (get $p0 "user_id") "status" "assigned" "updated_at" (iso-now)})))
        (add-event! (cid $gate) $tid (uid $gate) "assignees" "" "" "N명/용병 배정")
        (json-ok {"ticket_id" $tid "assignees" (db-rows (db-query "hq_ticket_assignees" {"ticket_id" $tid}))})))))

(defn handle-cart-list [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (json-ok (db-rows (db-query "hq_cart_lines" {"ticket_id" (server-req-param $req "id")}))))))

(defn invoice-locked? [$gate $tid]
  (and (= (?? (get (get $gate "user") "role") "") "technician")
       (> (length (filter (fn [$d] (= (?? (get $d "doc_type") "") "invoice"))
                          (db-rows (db-query "hq_documents" {"ticket_id" $tid}))))
          0)))

(defn handle-cart-add [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (if (field-write-denied? $gate (server-req-param $req "id"))
        (json-err 403 "not your assignment")
        (let [$tid (server-req-param $req "id")
            $body (req-body $req)
            $kind (?? (get $body "kind") "part")
            $locked (invoice-locked? $gate $tid)
            $pid (?? (get $body "product_id") "")
            $name (?? (get $body "name") "")
            $qty (?? (get $body "qty") 1)
            $price (?? (get $body "price") 0)
            $prd (if (= $pid "") nil (db-row (db-get-row "hq_products" $pid)))
            $nm (if (not (nil? $prd)) (get $prd "name") $name)
            $pr (if (not (nil? $prd)) (?? (get $prd "sale_price") $price) $price)
            $row {"line_id" (new-id "cart")
                  "company_id" (cid $gate)
                  "ticket_id" $tid
                  "kind" $kind
                  "product_id" $pid
                  "name" $nm
                  "qty" $qty
                  "price" $pr
                  "created_at" (iso-now)}]
        (if (or $locked (and (= (?? (get (get $gate "user") "role") "") "technician") (= $kind "travel")))
          (json-err 403 "cart locked or travel is automatic")
          (do
            (db-insert "hq_cart_lines" $row)
            (json-created $row))))))))

(defn handle-cart-qty [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$tid (server-req-param $req "id")
            $body (req-body $req)
            $lid (?? (get $body "line_id") "")
            $qty (?? (get $body "qty") 1)
            $line (db-row (db-get-row "hq_cart_lines" $lid))
            $locked (invoice-locked? $gate $tid)]
        (if (field-write-denied? $gate $tid)
          (json-err 403 "not your assignment")
          (if (or (nil? $line) (not (= (get $line "ticket_id") $tid)))
            (json-err 404 "line not found")
            (if $locked
              (json-err 403 "invoice locked")
              (do
                (db-patch "hq_cart_lines" $lid {"qty" $qty})
                (json-ok (db-rows (db-query "hq_cart_lines" {"ticket_id" $tid})))))))))))

(defn handle-cart-sync-travel [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (if (field-write-denied? $gate (server-req-param $req "id"))
        (json-err 403 "not your assignment")
        (let [$tid (server-req-param $req "id")
            $fin (finance-get $tid)
            $fee (?? (get $fin "travel_fee") 0)
            $lines (db-rows (db-query "hq_cart_lines" {"ticket_id" $tid}))
            $travels (filter (fn [$l] (= (get $l "kind") "travel")) $lines)]
        ;; insert or leave duplicates — insert one travel line each sync for simplicity if none
        (if (= (length $travels) 0)
          (db-insert "hq_cart_lines"
                     {"line_id" (new-id "cart")
                      "company_id" (cid $gate)
                      "ticket_id" $tid
                      "kind" "travel"
                      "product_id" ""
                      "name" "출장비"
                      "qty" 1
                      "price" $fee
                      "created_at" (iso-now)})
          (db-patch "hq_cart_lines" (get (get $travels 0) "line_id") {"price" $fee}))
        (json-ok (db-rows (db-query "hq_cart_lines" {"ticket_id" $tid}))))))))

(defn handle-contractor-create [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$body (req-body $req)
            $name (?? (get $body "name") "")]
        (if (= $name "")
          (json-err 400 "name required")
          (let [$row {"contractor_id" (new-id "ctr")
                      "company_id" (cid $gate)
                      "name" $name
                      "phone" (?? (get $body "phone") "")
                      "status" "active"
                      "created_at" (iso-now)}]
            (db-insert "hq_contractors" $row)
            (json-created $row)))))))

