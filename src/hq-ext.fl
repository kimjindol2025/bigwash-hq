  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (json-ok (db-rows (db-query "hq_contractors" {"company_id" (cid $gate)}))))))

(defn handle-ticket-log [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$tid (server-req-param $req "id")
            $memo (?? (get (req-body $req) "memo") "")]
        (if (field-write-denied? $gate $tid)
          (json-err 403 "not your assignment")
          (do
            (db-patch "hq_tickets" $tid {"work_note" $memo "updated_at" (iso-now)})
            (add-event! (cid $gate) $tid (uid $gate) "log" "" "" $memo)
