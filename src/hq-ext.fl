(defn handle-me-password [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$pw (?? (get (req-body $req) "password") "")
            $id (uid $gate)]
        (if (= $pw "")
          (json-err 400 "password required")
          (do
            (db-patch "hq_users" $id {"password_hash" (auth-hash-password $pw) "updated_at" (iso-now)})
            (json-ok {"user_id" $id "password_changed" true})))))))

(defn day-close-parse [$note]
  (let [$n (?? $note "")
        $mark "[[day-close]]"
        $i (str-index-of $n $mark)]
    (if (< $i 0)
      {"kind" "" "day" "" "note" ""}
      (let [$p (slice $n (+ $i (length $mark)))
            $a (str-index-of $p "|")
            $kind (if (< $a 0) $p (slice $p 0 $a))
            $rest (if (< $a 0) "" (slice $p (+ $a 1)))
            $b (str-index-of $rest "|")
            $day (if (< $b 0) $rest (slice $rest 0 $b))
            $memo (if (< $b 0) "" (slice $rest (+ $b 1)))]
        {"kind" $kind "day" $day "note" $memo}))))

(defn handle-day-close [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$body (req-body $req)
            $kind (?? (get $body "kind") "")
            $day (?? (get $body "day") (slice (iso-now) 0 10))
            $memo (?? (get $body "note") "")
            $id (uid $gate)
            $u (db-row (db-get-row "hq_users" $id))]
        (if (and (not (= $kind "clock_out")) (not (= $kind "return_hq")))
          (json-err 400 "kind clock_out|return_hq")
          (let [$prev (?? (get $u "note") "")
                $mark "[[day-close]]"
                $i (str-index-of $prev $mark)
                $base (if (< $i 0) $prev (slice $prev 0 $i))
                $next (str $base $mark $kind "|" $day "|" $memo)]
            (db-patch "hq_users" $id {"note" $next "updated_at" (iso-now)})
            (json-ok {"user_id" $id "kind" $kind "day" $day "note" $memo})))))))

(defn day-close-label [$kind]
  (if (= $kind "clock_out")
    "퇴근"
    (if (= $kind "return_hq") "본사 회기" "없음")))

(defn handle-day-close-lookup [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$uid (?? (server-req-query $req "user_id") (uid $gate))
            $day (?? (server-req-query $req "day") "")
            $u (db-row (db-get-row "hq_users" $uid))]
        (if (or (nil? $u) (not (= (get $u "company_id") (cid $gate))))
          (json-err 404 "Not found")
          (let [$p (day-close-parse (?? (get $u "note") ""))
                $kind (if (and (not (= $day "")) (not (= (get $p "day") $day)))
                        ""
                        (?? (get $p "kind") ""))]
            (json-ok {"user_id" $uid
                      "kind" $kind
                      "day" (if (= $kind "") $day (get $p "day"))
                      "note" (if (= $kind "") "" (?? (get $p "note") ""))
                      "label" (day-close-label $kind)})))))))

(defn handle-day-close-get [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$u (db-row (db-get-row "hq_users" (uid $gate)))
            $p (day-close-parse (?? (get $u "note") ""))]
        (json-ok (assoc $p "user_id" (uid $gate)))))))

(defn handle-legacy-gone [$req]
  (json-err 404 "legacy customer portal removed — use /hq"))
