;; HQ 확장 모듈 — 권역/몰/명세/정산/보고 (지시서 §9–17)
;; hq-server.fl 에서 load

(defn handle-regions-list [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (json-ok (db-rows (db-query "hq_regions" {"company_id" (cid $gate)}))))))

(defn handle-region-upsert [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$body (req-body $req)
            $id (?? (get $body "region_id") (new-id "reg"))
            $now (iso-now)
            $existing (db-row (db-get-row "hq_regions" $id))
            $row {"region_id" $id
                  "company_id" (cid $gate)
                  "metro" (?? (get $body "metro") "")
                  "detail" (?? (get $body "detail") "")
                  "name" (?? (get $body "name") "")
                  "travel_fee" (?? (get $body "travel_fee") 0)
                  "status" (?? (get $body "status") "active")
                  "created_at" (if (nil? $existing) $now (?? (get $existing "created_at") $now))
                  "updated_at" $now}]
        (if (= (get $row "name") "")
          (json-err 400 "name required")
          (if (nil? $existing)
            (do (db-insert "hq_regions" $row) (json-created $row))
            (do (db-patch "hq_regions" $id
                          {"metro" (get $row "metro")
                           "detail" (get $row "detail")
                           "name" (get $row "name")
                           "travel_fee" (get $row "travel_fee")
                           "status" (get $row "status")
                           "updated_at" $now})
                (json-ok $row))))))))

(defn region-fee [$region-id]
  (let [$r (db-row (db-get-row "hq_regions" $region-id))]
    (if (nil? $r) 0 (?? (get $r "travel_fee") 0))))

(defn handle-products-list [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$rows (db-rows (db-query "hq_products" {"company_id" (cid $gate)}))]
        (if (can-edit-money? $gate)
          (json-ok $rows)
          (json-ok (map (fn [$p] (assoc $p "cost_price" "")) $rows)))))))

(defn handle-product-create [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$body (req-body $req)
            $name (?? (get $body "name") "")
            $price (?? (get $body "sale_price") 0)]
        (if (= $name "")
          (json-err 400 "name required")
          (let [$id (new-id "prd")
                $now (iso-now)
                $row {"product_id" $id
                      "company_id" (cid $gate)
                      "name" $name
                      "category" (?? (get $body "category") "부품")
                      "spec" (?? (get $body "spec") "")
                      "sku" (?? (get $body "sku") "")
                      "sale_price" $price
                      "cost_price" (if (can-edit-money? $gate) (?? (get $body "cost_price") 0) 0)
                      "unit" (?? (get $body "unit") "EA")
                      "status" (?? (get $body "status") "active")
                      "description" (str "fulfill_type=" (?? (get $body "fulfill_type") "part")
                                         " | " (?? (get $body "description") ""))
                      "created_at" $now
                      "updated_at" $now}]
            (if (not (get (db-insert "hq_products" $row) "ok"))
              (json-err 500 "product create failed")
              (json-created (assoc $row "fulfill_type" (?? (get $body "fulfill_type") "part"))))))))))

(defn finance-get [$ticket-id]
  (let [$f (db-row (db-get-row "hq_ticket_finance" $ticket-id))]
    (if (nil? $f)
      {"ticket_id" $ticket-id
       "ticket_type" "dispatch"
       "region_id" ""
       "travel_fee" 0
       "settlement_status" ""
       "settlement_paid" 0
       "settlement_method" ""
       "work_log" ""
       "doc_ready" "false"}
      $f)))

(defn finance-upsert! [$company $ticket-id $patch]
  (let [$cur (db-row (db-get-row "hq_ticket_finance" $ticket-id))
        $now (iso-now)
        $base (if (nil? $cur)
                {"ticket_id" $ticket-id
                 "company_id" $company
                 "ticket_type" "dispatch"
                 "region_id" ""
                 "travel_fee" 0
                 "settlement_status" ""
                 "settlement_paid" 0
                 "settlement_method" ""
                 "work_log" ""
                 "doc_ready" "false"
                 "updated_at" $now}
                $cur)
        $merged (assoc (assoc (assoc (assoc (assoc $base
                                                   "region_id" (?? (get $patch "region_id") (get $base "region_id")))
                                            "travel_fee" (?? (get $patch "travel_fee") (get $base "travel_fee")))
                                     "ticket_type" (?? (get $patch "ticket_type") (get $base "ticket_type")))
                              "settlement_status" (?? (get $patch "settlement_status") (get $base "settlement_status")))
                       "updated_at" $now)
        $merged2 (assoc (assoc (assoc $merged
                                      "settlement_paid" (?? (get $patch "settlement_paid") (get $base "settlement_paid")))
                               "settlement_method" (?? (get $patch "settlement_method") (get $base "settlement_method")))
                        "work_log" (?? (get $patch "work_log") (get $base "work_log")))
        $merged3 (assoc $merged2 "doc_ready" (?? (get $patch "doc_ready") (get $base "doc_ready")))]
    (if (nil? $cur)
      (db-insert "hq_ticket_finance" $merged3)
      (db-patch "hq_ticket_finance" $ticket-id $merged3))
    $merged3))

(defn handle-ticket-finance-get [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (json-ok (finance-get (server-req-param $req "id"))))))

(defn handle-ticket-finance-set [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (if (field-write-denied? $gate (server-req-param $req "id"))
        (json-err 403 "not your assignment")
        (let [$id (server-req-param $req "id")
              $body0 (req-body $req)
            $role (?? (get (get $gate "user") "role") "")
            $body (if (= $role "technician")
                    {"settlement_status" (?? (get $body0 "settlement_status") "")
                     "settlement_paid" (?? (get $body0 "settlement_paid") 0)
                     "settlement_method" (?? (get $body0 "settlement_method") "")}
                    $body0)
            $region (?? (get $body "region_id") "")
            $fee (if (not (= $region ""))
                   (region-fee $region)
                   (?? (get $body "travel_fee") 0))
            $patch (if (= $role "technician")
                     $body
                     (assoc (assoc $body "region_id" $region) "travel_fee" $fee))
            $row (finance-upsert! (cid $gate) $id $patch)]
        (add-event! (cid $gate) $id (uid $gate) "finance" "" "" (str "권역/정산 갱신 fee=" $fee))
        (bust-dash-cache! (cid $gate))
        (json-ok $row))))))

(defn handle-doc-issue [$req]
  ;; 직원발행 가정 — 본사가 티켓에 명세 생성·보관
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$body (req-body $req)
            $tid (?? (get $body "ticket_id") "")
            $dtype (?? (get $body "doc_type") "invoice")
            $t (db-row (db-get-row "hq_tickets" $tid))
            $fin (finance-get $tid)]
        (if (nil? $t)
          (json-err 404 "ticket not found")
          (if (field-write-denied? $gate $tid)
            (json-err 403 "not your assignment")
            (let [$lines (?? (get $body "lines") [])
                $labor (?? (get $body "labor_fee") 0)
                $travel (?? (get $fin "travel_fee") 0)
                $parts-sum (reduce (fn [$a $l] (+ $a (* (?? (get $l "qty") 1) (?? (get $l "price") 0)))) 0 $lines)
                $bill (?? (get $body "bill_type") (?? (get $t "bill_type") "paid"))
                $total (if (= $bill "warranty") 0 (+ $parts-sum (+ $labor $travel)))
                $id (new-id "doc")
                $num (str (if (= $dtype "quote") "QT-" "IV-") (slice (iso-now) 0 10) "-" (slice (uuid_v4) 0 4))
                $now (iso-now)
                $c (db-row (db-get-row "hq_customers" (get $t "customer_id")))
                $eq (db-row (db-get-row "hq_equipment" (get $t "equipment_id")))
                $body-text (str
                             "문서:" $num "\n"
                             "유형:" $dtype "\n"
                             "고객:" (?? (get $c "display_name") "") "\n"
                             "장비:" (?? (get $eq "name") "") "\n"
                             "출장비:" $travel "\n"
                             "공임:" $labor "\n"
                             "부품합:" $parts-sum "\n"
                             "합계:" $total "\n"
                             "유상무상:" $bill "\n"
                             "라인:" (json-stringify $lines))
                $row {"doc_id" $id
                      "company_id" (cid $gate)
                      "ticket_id" $tid
                      "customer_id" (get $t "customer_id")
                      "doc_type" $dtype
                      "number" $num
                      "issued_at" $now
                      "total" $total
                      "bill_type" $bill
                      "travel_fee" $travel
                      "labor_fee" $labor
                      "lines_json" (json-stringify $lines)
                      "memo" (?? (get $body "memo") "")
                      "status" "issued"
                      "body_text" $body-text
                      "created_at" $now}]
            (do
              (db-insert "hq_documents" $row)
              (finance-upsert! (cid $gate) $tid {"doc_ready" "true"})
              (json-created $row)))))))))

(defn handle-docs-list [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$tid (?? (server-req-query $req "ticket_id") "")
            $rows (if (= $tid "")
                    (db-rows (db-query "hq_documents" {"company_id" (cid $gate)}))
                    (db-rows (db-query "hq_documents" {"company_id" (cid $gate) "ticket_id" $tid})))]
        (json-ok $rows)))))

(defn handle-doc-get [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$d (db-row (db-get-row "hq_documents" (server-req-param $req "id")))]
        (if (or (nil? $d) (not (= (get $d "company_id") (cid $gate))))
          (json-err 404 "Not found")
          (json-ok $d))))))

(defn handle-doc-download [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$d (db-row (db-get-row "hq_documents" (server-req-param $req "id")))
            $fmt (?? (server-req-query $req "format") "text")
            $title (if (= (get $d "doc_type") "quote") "견적서" "거래명세서")
            $content (?? (get $d "body_text") "")
            $acct "입금계좌: 국민 000-00-0000-000 예금주 빅워시"]
        (if (nil? $d)
          (json-err 404 "Not found")
          (let [$full (str $title "\n" $content "\n" $acct)
                $svg (str "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"600\" height=\"900\">"
                          "<rect width=\"100%\" height=\"100%\" fill=\"white\"/>"
                          "<text x=\"40\" y=\"60\" font-size=\"20\" font-family=\"monospace\">" $title "</text>"
                          "<foreignObject x=\"40\" y=\"90\" width=\"520\" height=\"780\">"
                          "<pre xmlns=\"http://www.w3.org/1999/xhtml\" style=\"font-size:12px;white-space:pre-wrap\">"
                          $full
                          "</pre></foreignObject></svg>")
                ;; minimal PDF with Helvetica text stream (same textual content)
                $stream (str "BT /F1 12 Tf 50 740 Td (" $title ") Tj 0 -20 Td (" (get $d "number") ") Tj 0 -20 Td (Account line included) Tj ET")
                $pdf (str "%PDF-1.4\n"
                          "1 0 obj<< /Type /Catalog /Pages 2 0 R >>endobj\n"
                          "2 0 obj<< /Type /Pages /Kids [3 0 R] /Count 1 >>endobj\n"
                          "3 0 obj<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] "
                          "/Contents 4 0 R /Resources<< /Font<< /F1 5 0 R >> >> >>endobj\n"
                          "4 0 obj<< /Length " (length $stream) " >>stream\n" $stream "\nendstream\nendobj\n"
                          "5 0 obj<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>endobj\n"
                          "xref\n0 6\n0000000000 65535 f \ntrailer<< /Size 6 /Root 1 0 R >>\nstartxref\n0\n%%EOF")
                $png-b64-path (str ROOT "/public/hq/assets/doc-portrait.png.b64")
                $png-b64 (if (file-exists $png-b64-path) (file-read $png-b64-path) "")]
            (json-ok {"doc_id" (get $d "doc_id")
                      "number" (get $d "number")
                      "format" $fmt
                      "title" $title
                      "content" $full
                      "pdf_base64" (base64-encode $pdf)
                      "image_png_base64" $png-b64
                      "image_svg" $svg
                      "image_note" "1차: PNG는 세로 템플릿 바이트 + 동일 content 문자열. 고품질 래스터 합성은 후속. SVG는 세로 이미지 대체본."
                      "total" (get $d "total")})))))))

(defn handle-expenses-list [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (json-ok (db-rows (db-query "hq_expenses" {"company_id" (cid $gate)}))))))

(defn bust-dash-cache! [$company]
  (try (file-write (str "/tmp/bigwash-hq-dash-" $company ".json") "{}") (catch $e nil)))

(defn handle-expense-create [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$body (req-body $req)
            $row {"expense_id" (new-id "exp")
                  "company_id" (cid $gate)
                  "user_id" (?? (get $body "user_id") (uid $gate))
                  "amount" (?? (get $body "amount") 0)
                  "category" (?? (get $body "category") "기타")
                  "memo" (?? (get $body "memo") "")
                  "receipt_note" (?? (get $body "receipt_note") "")
                  "status" "pending"
                  "created_at" (iso-now)
                  "decided_at" ""}]
        (db-insert "hq_expenses" $row)
        (bust-dash-cache! (cid $gate))
        (json-created $row)))))

(defn handle-expense-decide [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$id (server-req-param $req "id")
            $st (?? (get (req-body $req) "status") "")
            $e (db-row (db-get-row "hq_expenses" $id))]
        (if (nil? $e)
          (json-err 404 "Not found")
          (if (and (not (= $st "approved")) (not (= $st "rejected")))
            (json-err 400 "status approved|rejected")
            (do
              (db-patch "hq_expenses" $id {"status" $st "decided_at" (iso-now)})
              (bust-dash-cache! (cid $gate))
              (json-ok {"expense_id" $id "status" $st}))))))))

(defn handle-payroll-list [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$ym (?? (server-req-query $req "year_month") "")
            $rows (db-rows (db-query "hq_payroll" {"company_id" (cid $gate)}))
            $filtered (if (= $ym "") $rows (filter (fn [$r] (= (get $r "year_month") $ym)) $rows))]
        (json-ok $filtered)))))

(defn handle-opex-create [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$body (req-body $req)
            $row {"opex_id" (new-id "opx")
                  "company_id" (cid $gate)
                  "year_month" (?? (get $body "year_month") (slice (iso-now) 0 7))
                  "category" (?? (get $body "category") "기타")
                  "amount" (?? (get $body "amount") 0)
                  "memo" (?? (get $body "memo") "")
                  "created_at" (iso-now)}]
        (db-insert "hq_opex" $row)
        (bust-dash-cache! (cid $gate))
        (json-created $row)))))

(defn handle-opex-list [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (json-ok (db-rows (db-query "hq_opex" {"company_id" (cid $gate)}))))))

(defn can-edit-money? [$gate]
  (let [$r (?? (get (get $gate "user") "role") "")]
    (or (= $r "admin") (= $r "accountant") (= $r "finance"))))

(defn doc-total-for-ticket [$tid]
  (let [$docs (db-rows (db-query "hq_documents" {"ticket_id" $tid}))]
    (if (= (length $docs) 0)
      0
      (?? (get (get $docs 0) "total") 0))))

(defn enrich-settlement-row [$f]
  (let [$tid (get $f "ticket_id")
        $t (db-row (db-get-row "hq_tickets" $tid))
        $c (if (nil? $t) nil (db-row (db-get-row "hq_customers" (get $t "customer_id"))))
        $doc-total (doc-total-for-ticket $tid)
        $travel (?? (get $f "travel_fee") 0)
        $total (if (> $doc-total 0) $doc-total $travel)]
    {"ticket_id" $tid
     "number" (if (nil? $t) $tid (?? (get $t "number") $tid))
     "customer_id" (if (nil? $t) "" (get $t "customer_id"))
     "customer_name" (if (nil? $c) "" (?? (get $c "display_name") ""))
     "scheduled_at" (if (nil? $t) "" (?? (get $t "scheduled_at") ""))
     "completed_at" (if (nil? $t) "" (?? (get $t "completed_at") ""))
     "travel_fee" $travel
     "repair_total" $doc-total
     "total" $total
     "settlement_status" (?? (get $f "settlement_status") "")
     "settlement_paid" (?? (get $f "settlement_paid") 0)
     "settlement_method" (?? (get $f "settlement_method") "")}))

(defn handle-unpaid-list [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$fins (db-rows (db-query "hq_ticket_finance" {"company_id" (cid $gate)}))
            $unpaid (filter (fn [$f]
                              (or (= (get $f "settlement_status") "미수")
                                  (= (get $f "settlement_status") "부분수금")))
                            $fins)]
        (json-ok (map enrich-settlement-row $unpaid))))))

(defn handle-settlements [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$tab (?? (server-req-query $req "tab") "unpaid")
            $period (?? (server-req-query $req "period") "month")
            $fins (db-rows (db-query "hq_ticket_finance" {"company_id" (cid $gate)}))
            $today (slice (iso-now) 0 10)
            $ym (slice (iso-now) 0 7)
            $rows (cond
                    [(= $tab "unpaid")
                     (filter (fn [$f]
                               (or (= (get $f "settlement_status") "미수")
                                   (= (get $f "settlement_status") "부분수금")))
                             $fins)]
                    [(= $tab "collected")
                     (filter (fn [$f]
                               (let [$st (?? (get $f "settlement_status") "")
                                     $ok (or (= $st "카드완납") (= $st "계좌완납") (= $st "현금완납")
                                             (= $st "부분수금") (= $st "해당없음"))
                                     $enriched (enrich-settlement-row $f)
                                     $day (slice (?? (get $enriched "completed_at") (?? (get $enriched "scheduled_at") "")) 0 10)]
                                 (and $ok
                                      (or (= $period "all")
                                          (and (= $period "today") (str-starts-with $day $today))
                                          (and (= $period "month") (str-starts-with $day $ym))
                                          (= $period "week")))))
                             $fins)]
                    [true []])
            $enriched (map enrich-settlement-row $rows)
            $sum-travel (reduce (fn [$a $r] (+ $a (?? (get $r "travel_fee") 0))) 0 $enriched)
            $sum-repair (reduce (fn [$a $r] (+ $a (?? (get $r "repair_total") 0))) 0 $enriched)
            $sum-paid (reduce (fn [$a $r] (+ $a (?? (get $r "settlement_paid") 0))) 0 $enriched)]
        (json-ok {"tab" $tab
                  "period" $period
                  "rows" $enriched
                  "sum_travel" $sum-travel
                  "sum_repair" $sum-repair
                  "sum_paid" $sum-paid})))))

(defn handle-payroll-upsert [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (if (not (can-edit-money? $gate))
        (json-err 403 "payroll edit requires admin/accountant")
        (let [$body (req-body $req)
              $uid (?? (get $body "user_id") "")
              $ym (?? (get $body "year_month") "")
              $base (?? (get $body "base_pay") 0)
              $allow (?? (get $body "allowances") 0)
              $ded (?? (get $body "deductions") 0)
              $total (+ $base (- $allow $ded))]
          (if (or (= $uid "") (= $ym ""))
            (json-err 400 "user_id and year_month required")
            (let [$id (str "pay-" $uid "-" $ym)
                  $existing (db-row (db-get-row "hq_payroll" $id))
                  $row {"payroll_id" $id
                        "company_id" (cid $gate)
                        "user_id" $uid
                        "year_month" $ym
                        "base_pay" $base
                        "allowances" $allow
                        "deductions" $ded
                        "total" $total
                        "note" (?? (get $body "note") "")
                        "created_at" (iso-now)}]
              (if (nil? $existing)
                (do (db-insert "hq_payroll" $row)
                    (bust-dash-cache! (cid $gate))
                    (json-created $row))
                (do (db-patch "hq_payroll" $id
                              {"base_pay" $base "allowances" $allow "deductions" $ded "total" $total
                               "note" (get $row "note")})
                    (bust-dash-cache! (cid $gate))
                    (json-ok (assoc $row "total" $total)))))))))))

(defn handle-report [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$kind (?? (server-req-query $req "period") (?? (server-req-query $req "kind") "daily"))
            $company (cid $gate)
            $tickets (db-rows (db-query "hq_tickets" {"company_id" $company}))
            $calls (db-rows (db-query "hq_call_logs" {"company_id" $company}))
            $pays (db-rows (db-query "hq_payroll" {"company_id" $company}))
            $exps (db-rows (db-query "hq_expenses" {"company_id" $company}))
            $opex (db-rows (db-query "hq_opex" {"company_id" $company}))
            $fins (db-rows (db-query "hq_ticket_finance" {"company_id" $company}))
            $today (slice (iso-now) 0 10)
            $ym (slice (iso-now) 0 7)
            $today-calls (length (filter (fn [$c] (str-starts-with (?? (get $c "created_at") "") $today)) $calls))
            $today-tickets (length (filter (fn [$t] (str-starts-with (?? (get $t "created_at") "") $today)) $tickets))
            $today-done (length (filter (fn [$t] (str-starts-with (?? (get $t "completed_at") "") $today)) $tickets))
            $open (length (filter (fn [$t]
                                    (and (not (= (get $t "status") "closed"))
                                         (not (= (get $t "status") "cancelled")))) $tickets))
            $today-exp (reduce (fn [$a $e] (+ $a (?? (get $e "amount") 0))) 0
                               (filter (fn [$e] (str-starts-with (?? (get $e "created_at") "") $today)) $exps))
            $today-paid (reduce (fn [$a $f] (+ $a (?? (get $f "settlement_paid") 0))) 0
                                (filter (fn [$f]
                                          (let [$en (enrich-settlement-row $f)]
                                            (str-starts-with (?? (get $en "completed_at") "") $today)))
                                        $fins))
            $unpaid-n (length (filter (fn [$f]
                                        (or (= (get $f "settlement_status") "미수")
                                            (= (get $f "settlement_status") "부분수금"))) $fins))
            $pay-month (reduce (fn [$a $p] (+ $a (?? (get $p "total") 0))) 0
                               (filter (fn [$p] (= (get $p "year_month") $ym)) $pays))
            $opex-month (reduce (fn [$a $o] (+ $a (?? (get $o "amount") 0))) 0
                                (filter (fn [$o] (= (get $o "year_month") $ym)) $opex))
            $exp-month (reduce (fn [$a $e] (+ $a (?? (get $e "amount") 0))) 0
                               (filter (fn [$e] (and (= (get $e "status") "approved")
                                                     (str-starts-with (?? (get $e "created_at") "") $ym))) $exps))
            $travel-month (reduce (fn [$a $f] (+ $a (?? (get $f "travel_fee") 0))) 0
                                  (filter (fn [$f]
                                            (let [$en (enrich-settlement-row $f)]
                                              (str-starts-with (?? (get $en "completed_at") (?? (get $en "scheduled_at") "")) $ym)))
                                          $fins))
            $repeats (length (filter (fn [$t] (= (?? (get $t "is_repeat") "") "true")) $tickets))
            $summary (cond
                       [(or (= $kind "daily") (= $kind "day"))
                        {"period" "daily"
                         "today_calls" $today-calls
                         "today_tickets" $today-tickets
                         "today_done" $today-done
                         "open" $open
                         "today_paid" $today-paid
                         "today_expense" $today-exp}]
                       [(or (= $kind "weekly") (= $kind "week"))
                        {"period" "weekly"
                         "open" $open
                         "unpaid" $unpaid-n
                         "travel_sum" $travel-month
                         "tickets" (length $tickets)}]
                       [true
                        {"period" "monthly"
                         "as_count" (length $tickets)
                         "repeats" $repeats
                         "paid_sum" (reduce (fn [$a $f] (+ $a (?? (get $f "settlement_paid") 0))) 0 $fins)
                         "ops_sum" (+ $travel-month (+ $opex-month $exp-month))
                         "payroll_total" $pay-month
                         "unpaid" $unpaid-n}])
            $csv (cond
                   [(or (= $kind "daily") (= $kind "day"))
                    (str "지표,값\n오늘콜," $today-calls "\n오늘출장," $today-tickets "\n완료," $today-done
                         "\n미처리," $open "\n당일수금," $today-paid "\n당일경비," $today-exp "\n")]
                   [(or (= $kind "weekly") (= $kind "week"))
                    (str "assignee_id,status,number\n"
                         (reduce (fn [$a $t]
                                   (str $a (?? (get $t "assignee_id") "none") "," (get $t "status") "," (get $t "number") "\n"))
                                 ""
                                 $tickets))]
                   [true
                    (str "지표,값\nAS건수," (length $tickets) "\n재고장," $repeats
                         "\n수금합," (reduce (fn [$a $f] (+ $a (?? (get $f "settlement_paid") 0))) 0 $fins)
                         "\n출장운영경비," (+ $travel-month (+ $opex-month $exp-month))
                         "\n급여총액," $pay-month "\n미수," $unpaid-n "\n")])]
        (json-ok {"kind" $kind "period" $kind "summary" $summary "csv" $csv "format" "excel-csv"})))))

;; ===== v2: purchases / assignees / cart / contractors / warranty =====

(defn days-between-iso [$a $b]
  ;; approximate using now-ms style: store days as string compare fallback
  ;; Expect YYYY-MM-DD; return rough day delta via unix if possible
  (let [$as (slice (?? $a "") 0 10)
        $bs (slice (?? $b "") 0 10)]
    ;; without date lib: use string order only for hint UI; compute via JS in tests with patch
    0))

(defn warranty-hint [$company $customer-id $equipment-id $as-of]
  (let [$purchases (db-rows (db-query "hq_customer_purchases" {"company_id" $company "customer_id" $customer-id}))
        $as (slice (?? $as-of (iso-now)) 0 10)
        $hits (filter (fn [$p]
                        (let [$eqp (?? (get $p "equipment_id") "")
                              $ok-eq (or (= $eqp "")
                                         (= $eqp $equipment-id)
                                         (= $equipment-id ""))
                              $start (slice (?? (get $p "confirm_date") "") 0 10)
                              $y0 (slice $start 0 4)
                              $rest (slice $start 4)
                              $y1 (str (+ (str-to-num $y0) 1))
                              $end (str $y1 $rest)]
                          (and $ok-eq
                               (not (= $start ""))
                               (<= $start $as)
                               (<= $as $end))))
                      $purchases)]
    (if (> (length $hits) 0)
      {"warranty" "free" "reason" "purchase_within_365" "purchase" (get $hits 0)}
      {"warranty" "paid" "reason" "no_purchase_or_expired"})))

(defn handle-purchase-create [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$body (req-body $req)
            $row {"purchase_id" (new-id "pur")
                  "company_id" (cid $gate)
                  "customer_id" (?? (get $body "customer_id") "")
                  "product_id" (?? (get $body "product_id") "")
                  "fulfill_type" (?? (get $body "fulfill_type") "ship")
                  "confirm_date" (?? (get $body "confirm_date") "")
                  "equipment_id" (?? (get $body "equipment_id") "")
                  "note" (?? (get $body "note") "")
                  "created_at" (iso-now)}]
        (if (or (= (get $row "customer_id") "") (= (get $row "product_id") "") (= (get $row "confirm_date") ""))
          (json-err 400 "customer_id, product_id, confirm_date required")
          (do (db-insert "hq_customer_purchases" $row) (json-created $row)))))))

(defn handle-purchases-list [$req]
  (let [$gate (require-user $req)]
    (if (not (get $gate "ok"))
      (json-err (get $gate "status") (get $gate "error"))
      (let [$cid (?? (server-req-query $req "customer_id") "")
            $rows (if (= $cid "")
                    (db-rows (db-query "hq_customer_purchases" {"company_id" (cid $gate)}))
                    (db-rows (db-query "hq_customer_purchases" {"company_id" (cid $gate) "customer_id" $cid})))]
        (json-ok $rows)))))

(defn handle-warranty-hint [$req]
  (let [$gate (require-user $req)]
