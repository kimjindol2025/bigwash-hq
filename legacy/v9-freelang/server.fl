;; bigwash-as/v9/server.fl
;; v1.0 - Bigwash AS Request System (FreeLang v9)

;; Server Configuration
[SERVER bigwash-as
  :port 3000
  :host "localhost"
  :name "Bigwash AS Management"
  :description "AS Request System - v9"
]

;; Core Data Storage
[STORE as-storage
  :type "memory"
  :schema {
    :requests []
    :admins []
    :notifications []
  }
]

;; Authentication Functions
[FUNC validate-credentials
  :params [$username $password]
  :body (and (= $username "admin") (= $password "admin123"))
]

[FUNC generate-token
  :params [$username]
  :body (concat "token-" $username "-" (timestamp))
]

;; Validation Functions
[FUNC is-valid-phone
  :params [$phone]
  :body (and (not-nil $phone) (> (length $phone) 9))
]

[FUNC is-valid-request
  :params [$name $phone $symptom]
  :body (and
    (not-empty $name)
    (is-valid-phone $phone)
    (not-empty $symptom)
  )
]

[FUNC is-valid-status
  :params [$status]
  :body (or
    (= $status "received")
    (= $status "assigned")
    (= $status "in_progress")
    (= $status "done")
  )
]

;; Helper Functions
[FUNC not-empty
  :params [$val]
  :body (and $val (> (length $val) 0))
]

[FUNC not-nil
  :params [$val]
  :body (not (nil? $val))
]

;; Business Logic Functions
[FUNC create-request-object
  :params [$name $phone $equipment $symptom]
  :body {
    :id (concat "as-" (timestamp))
    :customer-name $name
    :customer-phone $phone
    :equipment-name $equipment
    :symptom $symptom
    :status "received"
    :created-at (now)
    :updated-at (now)
  }
]

[FUNC log-notification
  :params [$phone $content]
  :body (do
    (println (concat "SMS: " $phone " - " $content))
    true
  )
]

;; API Routes

[ROUTE health
  :method "GET"
  :path "/health"
  :handler (json-response {
    :status "ok"
    :timestamp (now)
    :service "bigwash-as-v9"
  } 200)
]

[ROUTE login
  :method "POST"
  :path "/admin/login"
  :params [$username $password]
  :handler (if (validate-credentials $username $password)
    (json-response {
      :token (generate-token $username)
      :admin-id "admin-001"
    } 200)
    (json-response {
      :error "Invalid credentials"
    } 401)
  )
]

[ROUTE register-as
  :method "POST"
  :path "/as/register"
  :params [$customer-name $customer-phone $equipment-name $symptom $address]
  :handler (if (is-valid-request $customer-name $customer-phone $symptom)
    (let [
      [:req (create-request-object $customer-name $customer-phone $equipment-name $symptom)]
    ]
      (do
        (log-notification $customer-phone "AS Request Registered")
        (json-response {
          :id (get $req :id)
          :status "received"
          :created-at (get $req :created-at)
        } 201)
      )
    )
    (json-response {
      :error "Validation failed"
    } 400)
  )
]

[ROUTE list-requests
  :method "GET"
  :path "/as/list"
  :auth true
  :handler (json-response {
    :requests []
    :total 0
  } 200)
]

[ROUTE get-request
  :method "GET"
  :path "/as/:id"
  :auth true
  :params [$id]
  :handler (json-response {
    :id $id
    :status "received"
  } 200)
]

[ROUTE update-status
  :method "PUT"
  :path "/as/:id/status"
  :auth true
  :params [$id $new-status]
  :handler (if (is-valid-status $new-status)
    (json-response {
      :id $id
      :status $new-status
      :updated-at (now)
    } 200)
    (json-response {
      :error "Invalid status"
    } 400)
  )
]

;; Error Handlers

[ERROR-HANDLER global-errors
  :on-404 (json-response {
    :error "Not found"
    :path (request-path)
  } 404)
  :on-500 (json-response {
    :error "Server error"
  } 500)
]

;; Middleware

[MIDDLEWARE logging
  :log-format "[{method}] {path} - {status}"
]

[MIDDLEWARE cors
  :origin "*"
  :methods ["GET" "POST" "PUT" "DELETE"]
]

;; Helper Response Function
[FUNC json-response
  :params [$data $code]
  :body {
    :status $code
    :body (stringify $data)
    :headers { :Content-Type "application/json" }
  }
]

;; Server Startup
[PIPE init-server
  :input "startup"
  :steps (
    (println "Bigwash AS System v9 - Starting")
    (println "Server listening on port 3000")
    (println "Ready for requests")
  )
  :output "running"
]

;; Entry Point
(println "Server initialized")
