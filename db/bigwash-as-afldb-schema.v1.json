    },
    {
      "name": "bigwash_notifications",
      "primary_key": "notification_id",
      "columns": [
        {"name": "notification_id", "type": "string"},
        {"name": "as_request_id", "type": "string", "indexed": true, "ref": {"table": "bigwash_as_requests", "column": "as_id"}},
        {"name": "customer_phone", "type": "string", "required": true},
        {"name": "content", "type": "string", "required": true},
