      "primary_key": "as_id",
      "columns": [
        {"name": "as_id", "type": "string"},
        {"name": "receipt_no", "type": "string", "required": true, "indexed": true},
        {"name": "customer_id", "type": "string", "indexed": true, "ref": {"table": "bigwash_customers", "column": "customer_id"}},
        {"name": "customer_name", "type": "string", "required": true},
        {"name": "customer_phone", "type": "string", "required": true, "indexed": true},
