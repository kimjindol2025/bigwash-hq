;; bigwash-as/v9/server.fl
;; v1.0 - Bigwash AS Request System
;; FreeLang v9 Implementation

;; ====================
;; Data Models
;; ====================

[INTENT register-as-request
  :customer-name "Hong Gildong"
  :customer-phone "010-1234-5678"
  :equipment-name "High pressure cleaner"
  :symptom "Low pressure"
  :address "Seoul"
]

[INTENT update-as-status
  :as-id $as-id
  :new-status "assigned"
  :timestamp (get-timestamp)
]

[INTENT send-notification
  :as-id $as-id
  :customer-phone $phone
  :content "AS Status Updated"
  :channel "sms"
]

;; ====================
;; Core Functions
;; ====================

[FUNC generate-id
  :params []
  :body (concat "as-" (timestamp))
]

[FUNC validate-as-request
  :params [$name $phone $symptom]
  :body (and
    (not-empty $name)
    (not-empty $phone)
    (not-empty $symptom)
  )
]

[FUNC create-as-request
  :params [$name $phone $equipment $symptom $address]
  :body (ref as-request
    :id (generate-id)
    :customer-name $name
    :customer-phone $phone
    :equipment-name $equipment
    :symptom $symptom
    :status "received"
    :created-at (get-timestamp)
    :updated-at (get-timestamp)
  )
]

[FUNC validate-status
  :params [$status]
  :body (member $status ["received" "assigned" "in_progress" "done"])
]

[FUNC update-status
  :params [$as-id $new-status]
  :body (if (validate-status $new-status)
    (do
      (update ref as-request :id $as-id
        :status $new-status
        :updated-at (get-timestamp)
      )
      (if (= $new-status "done")
        (update ref as-request :id $as-id
          :completed-at (get-timestamp)
        )
      )
      true
    )
    false
  )
]

;; ====================
;; HTTP Handlers
;; ====================

[INTENT health-check
  :path "/health"
  :method "GET"
  :response (json-response
    :status 200
    :body "{\"status\": \"ok\"}"
  )
]

[INTENT admin-login
  :path "/admin/login"
  :method "POST"
  :params [$username $password]
  :steps (
    (validate-credentials $username $password)
    (if (valid)
      (json-response
        :status 200
        :body (json-stringify
          :token (generate-jwt $username)
          :admin-id "admin-001"
        )
      )
      (json-response
        :status 401
        :body "{\"error\": \"Invalid credentials\"}"
      )
    )
  )
]

[INTENT register-request
  :path "/as/register"
  :method "POST"
  :params [$name $phone $equipment $symptom $address]
  :steps (
    (if (validate-as-request $name $phone $symptom)
      (do
        (let $as (create-as-request $name $phone $equipment $symptom $address))
        (save-request $as)
        (send-sms $phone "AS registered successfully")
        (json-response
          :status 201
          :body (json-stringify
            :id (get $as :id)
            :status "received"
          )
        )
      )
      (json-response
        :status 400
        :body "{\"error\": \"Missing required fields\"}"
      )
    )
  )
]

[INTENT list-requests
  :path "/as/list"
  :method "GET"
  :auth-required true
  :steps (
    (if (authorized)
      (json-response
        :status 200
        :body (json-stringify (get-all-requests))
      )
      (json-response
        :status 401
        :body "{\"error\": \"Unauthorized\"}"
      )
    )
  )
]

[INTENT get-request
  :path "/as/:id"
  :method "GET"
  :params [$id]
  :auth-required true
  :steps (
    (if (authorized)
      (let $req (get-request-by-id $id))
      (if (not-nil $req)
        (json-response
          :status 200
          :body (json-stringify $req)
        )
        (json-response
          :status 404
          :body "{\"error\": \"Not found\"}"
        )
      )
      (json-response
        :status 401
        :body "{\"error\": \"Unauthorized\"}"
      )
    )
  )
]

[INTENT update-request-status
  :path "/as/:id/status"
  :method "PUT"
  :params [$id $new-status]
  :auth-required true
  :steps (
    (if (authorized)
      (if (validate-status $new-status)
        (if (update-status $id $new-status)
          (do
            (let $req (get-request-by-id $id))
            (send-sms (get $req :customer-phone) (status-message $new-status))
            (json-response
              :status 200
              :body (json-stringify
                :status $new-status
                :updated-at (get-timestamp)
              )
            )
          )
          (json-response
            :status 500
            :body "{\"error\": \"Update failed\"}"
          )
        )
        (json-response
          :status 400
          :body "{\"error\": \"Invalid status\"}"
        )
      )
      (json-response
        :status 401
        :body "{\"error\": \"Unauthorized\"}"
      )
    )
  )
]

;; ====================
;; Helper Functions
;; ====================

[FUNC get-timestamp
  :params []
  :body "2026-04-09T12:00:00Z"
]

[FUNC json-response
  :params [$status $body]
  :body (ref response
    :status-code $status
    :body $body
    :headers "{\"Content-Type\": \"application/json\"}"
  )
]

[FUNC json-stringify
  :params [& $args]
  :body (stringify-json $args)
]

[FUNC status-message
  :params [$status]
  :body (case $status
    "assigned" "Technician assigned"
    "in_progress" "Work in progress"
    "done" "Service completed"
    "Status updated"
  )
]

[FUNC send-sms
  :params [$phone $message]
  :body (do
    (log "SMS: " $phone " - " $message)
    true
  )
]

[FUNC validate-credentials
  :params [$username $password]
  :body (and
    (= $username "admin")
    (= $password "admin123")
  )
]

[FUNC generate-jwt
  :params [$username]
  :body (concat "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9." $username)
]

[FUNC authorized
  :params []
  :body (not-nil (get-token))
]

[FUNC get-token
  :params []
  :body (get-header "Authorization")
]

;; ====================
;; Server Entry Point
;; ====================

[PIPE start-server
  :input "application-start"
  :steps (
    (println "Bigwash AS System v9 - Starting...")
    (init-storage)
    (start-http-server :port 3000)
    (println "Server running on port 3000")
    (println "Ready to receive AS requests")
  )
  :output "server-running"
]
